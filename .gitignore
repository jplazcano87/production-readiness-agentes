# Claves y entorno
.env
.venv/
venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
dist/
build/

# Seguimiento opcional
mlruns/

# Artefactos locales de ejecución (los resultados canónicos SÍ se versionan)
runs/
# Las ~1.000 ejecuciones de E1 con su transcripción completa: ~15 MB de artefactos
# generados. La etapa 8 copiará a data/annotation/ las 80 que muestrea para anotar, que
# son las que el informe cita.
# Transcripciones archivadas de corridas anteriores de E1: la evidencia por caso vive
# localmente; el JSON canónico de cada corrida sí está versionado.
results/runs_e1_*/
# Transcripciones por ejecución de E2 y E3: 28 MB y 8,5 MB. El JSON canónico de cada
# experimento lleva las observaciones caso por caso, que es lo que el informe cita; estas
# quedan localmente para poder revisar una ejecución concreta.
*.log

# macOS
.DS_Store

# Corpus de trabajo de la calibración de ataques (dev): no es un corpus congelado.
data/corpus/v1.2-dev/
data/splits/v1.2-dev/
# Resultados de las rondas de calibración de los ataques de v1.2. Se publican las tres
# rondas, porque son la evidencia de que la fuerza de los ataques se ajustó solo sobre la
# partición de desarrollo; lo que no se publica es el corpus de trabajo con que corrieron.
results/e2_cal_r*.json
!results/e2_cal_r1.json
!results/e2_cal_r2.json
!results/e2_cal_r3.json

# Entregables generados para terceros (interfaz de anotación de E6). Llevan las
# transcripciones embebidas y la tabla que rompe el ciegamiento: se generan, no se versionan.
exports/

# --- transcripciones por ejecución: se publican las que sostienen una cifra ---
